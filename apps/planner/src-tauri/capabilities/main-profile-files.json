{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-profile-files",
  "description": "Allows the main window to open and save only project files selected through native dialogs.",
  "local": true,
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file"
  ]
}
