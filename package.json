{
  "name": "run-planner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @run-planner/planner",
    "desktop:dev": "npm run desktop:dev --workspace @run-planner/planner",
    "desktop:check": "npm run desktop:check --workspace @run-planner/planner",
    "desktop:build": "npm run desktop:build --workspace @run-planner/planner",
    "desktop:build:windows": "npm run desktop:build:windows --workspace @run-planner/planner",
    "schema:split-72-to-73": "node schema/split-project-72-to-73.js",
    "schema:migrate-73-to-74": "node schema/migrate-project-73-to-74.js",
    "schema:migrate-74-to-75": "node schema/migrate-project-74-to-75.js",
    "schema:migrate-75-to-76": "node schema/migrate-project-75-to-76.js",
    "schema:migrate-76-to-77": "node schema/migrate-project-76-to-77.js",
    "schema:migrate-77-to-78": "node schema/migrate-project-77-to-78.js",
    "schema:migrate-78-to-79": "node schema/migrate-project-78-to-79.js",
    "schema:migrate-79-to-80": "node schema/migrate-project-79-to-80.js",
    "schema:migrate-80-to-81": "node schema/migrate-project-80-to-81.js",
    "schema:migrate-81-to-82": "node schema/migrate-project-81-to-82.js",
    "schema:migrate-82-to-83": "node schema/migrate-project-82-to-83.js",
    "schema:migrate-83-to-84": "node schema/migrate-project-83-to-84.js",
    "schema:migrate-84-to-85": "node schema/migrate-project-84-to-85.js",
    "schema:migrate-85-to-86": "node schema/migrate-project-85-to-86.js",
    "build": "npm run build --workspace @run-planner/planner",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:fixtures",
    "typecheck:fixtures": "tsc --project test/fixtures/authored-project/tsconfig.json",
    "test": "npm run test:correctness && npm run test:performance",
    "test:correctness": "vitest run --config vitest.config.ts",
    "test:performance": "npm run test:performance:unit && npm run test:performance:compare",
    "test:performance:unit": "node --test scripts/performance-comparison.test.mjs",
    "test:performance:compare": "node scripts/compare-performance-snapshot.mjs",
    "test:performance:absolute": "node scripts/run-performance-absolute.mjs",
    "test:performance:snapshot": "node scripts/run-performance-snapshot.mjs",
    "test:performance:changed": "vitest run --changed --passWithNoTests --config vitest.performance.config.ts",
    "test:performance:watch": "vitest --config vitest.performance.config.ts",
    "test:changed": "vitest run --changed --passWithNoTests && npm run test:performance:changed",
    "test:fixtures:check": "vitest run --config vitest.fixtures.config.ts",
    "fixtures:execution": "node scripts/regenerate-execution-fixtures.mjs",
    "fixtures:checkpoints": "node scripts/repair-reward-store-checkpoints.mjs",
    "test:schema:split": "node --test schema/split-project-72-to-73.test.js",
    "test:schema:migrate": "node --test schema/migrate-project-73-to-74.test.js schema/migrate-project-74-to-75.test.js schema/migrate-project-75-to-76.test.js schema/migrate-project-76-to-77.test.js schema/migrate-project-77-to-78.test.js schema/migrate-project-78-to-79.test.js schema/migrate-project-79-to-80.test.js schema/migrate-project-80-to-81.test.js schema/migrate-project-81-to-82.test.js schema/migrate-project-82-to-83.test.js schema/migrate-project-83-to-84.test.js schema/migrate-project-84-to-85.test.js schema/migrate-project-85-to-86.test.js schema/migrate-project-86-to-87.test.js",
    "test:catalog": "vitest run packages/hades2-catalog/test",
    "test:engine": "vitest run packages/planner-engine/test",
    "test:planner": "vitest run apps/planner/test --exclude \"apps/planner/test/product-loops/**\"",
    "test:ui": "vitest run apps/planner/test/ui",
    "test:contract": "vitest run apps/planner/test/architecture apps/planner/test/support/structured-workspace apps/planner/test/projections/structuredWorkspace.contract.test.ts",
    "test:product": "vitest run apps/planner/test/product-loops --exclude apps/planner/test/product-loops/UnifiedBiomePerformance.test.ts && npm run test:performance",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run test:fixtures:check && npm run test && npm run lint && npm run format:check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
