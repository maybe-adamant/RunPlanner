{
  "name": "run-planner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @run-planner/planner",
    "desktop:dev": "npm run desktop:dev --workspace @run-planner/planner",
    "desktop:build": "npm run desktop:build --workspace @run-planner/planner",
    "build": "npm run build --workspace @run-planner/planner",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:regular && npm run test:heavy",
    "test:regular": "vitest run --config vitest.regular.config.ts",
    "test:heavy": "vitest run --config vitest.heavy.config.ts",
    "test:changed": "vitest run --changed",
    "test:catalog": "vitest run packages/hades2-catalog/test",
    "test:engine": "vitest run packages/planner-engine/test",
    "test:planner": "vitest run apps/planner/src apps/planner/test/architecture apps/planner/test/support/structured-workspace",
    "test:ui": "vitest run apps/planner/src/ui",
    "test:contract": "vitest run apps/planner/test/architecture apps/planner/test/support/structured-workspace apps/planner/src/projections/structuredWorkspace.contract.test.ts",
    "test:product": "vitest run apps/planner/test/product-loops",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run test && npm run lint && npm run format:check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
