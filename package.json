{
  "name": "run-planner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @run-planner/planner",
    "desktop:dev": "npm run desktop:dev --workspace @run-planner/planner",
    "desktop:check": "npm run desktop:check --workspace @run-planner/planner",
    "desktop:build": "npm run desktop:build --workspace @run-planner/planner",
    "desktop:build:windows": "npm run desktop:build:windows --workspace @run-planner/planner",
    "schema:migrate": "node schema/migrate-project.js",
    "build": "npm run build --workspace @run-planner/planner",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:fixtures",
    "typecheck:fixtures": "tsc --project test/fixtures/authored-project/tsconfig.json",
    "test": "npm run test:correctness",
    "test:correctness": "vitest run --config vitest.config.ts",
    "test:performance": "npm run test:performance:unit && npm run test:performance:compare",
    "test:performance:unit": "node --test scripts/performance-comparison.test.mjs",
    "test:performance:compare": "node scripts/compare-performance-snapshot.mjs",
    "test:performance:absolute": "node scripts/run-performance-absolute.mjs",
    "test:performance:snapshot": "node scripts/run-performance-snapshot.mjs",
    "test:performance:changed": "vitest run --changed --passWithNoTests --config vitest.performance.config.ts",
    "test:performance:watch": "vitest --config vitest.performance.config.ts",
    "test:changed": "vitest run --changed --passWithNoTests && npm run test:performance:changed",
    "test:fixtures:check": "vitest run --config vitest.fixtures.config.ts",
    "test:equivalence": "vitest run --config vitest.equivalence.config.ts",
    "test:draft-corpus": "vitest run --config vitest.draft-corpus.config.ts",
    "fixtures:execution": "node scripts/regenerate-execution-fixtures.mjs",
    "fixtures:modeled-traits": "node scripts/regenerate-modeled-traits.mjs",
    "fixtures:run-record": "node scripts/regenerate-run-record-fixture.mjs",
    "fixtures:checkpoints:regenerate": "node scripts/regenerate-authored-checkpoints.mjs",
    "fixtures:checkpoints": "node scripts/repair-reward-store-checkpoints.mjs",
    "test:schema:migrate": "node --test \"schema/*.test.js\"",
    "test:catalog": "vitest run packages/hades2-catalog/test",
    "test:engine": "vitest run packages/planner-engine/test",
    "test:run-import": "vitest run packages/planner-engine/test/run-record packages/planner-engine/test/simulation/run-import apps/planner/test/workspace/run-recording",
    "test:planner": "vitest run apps/planner/test --exclude \"apps/planner/test/product-loops/**\"",
    "test:ui": "vitest run apps/planner/test/ui",
    "test:contract": "vitest run apps/planner/test/architecture apps/planner/test/support/structured-workspace apps/planner/test/projections/structuredWorkspace.contract.test.ts",
    "test:release": "node --test scripts/updater-release.test.mjs scripts/events-build.test.mjs scripts/catalog-build.test.mjs",
    "events:build": "node scripts/events-build.mjs",
    "catalog:build": "node scripts/catalog-build.mjs",
    "test:catalog-entries": "node scripts/catalog-entries.mjs",
    "test:game-host": "cargo test --locked --manifest-path apps/planner/src-tauri/Cargo.toml -p run-planner-game-host",
    "test:game-module": "node scripts/check-game-module-syntax.mjs && cd game-module && lua tests/all.lua && luacheck --quiet src",
    "test:product": "vitest run apps/planner/test/product-loops --exclude apps/planner/test/product-loops/UnifiedBiomePerformance.test.ts",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
